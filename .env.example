# ============================================================
#  T.M.H International School: site settings
#  Change a value here, then STOP and RESTART `npm run dev`.
#  (For a live site, run `npm run build` again.)
#  Never put passwords or secret keys in this file: everything
#  here becomes visible in the website code.
# ============================================================

# ---- School ----
VITE_SCHOOL_NAME="T.M.H International School"
VITE_SCHOOL_SHORT_NAME="T.M.H"
VITE_SCHOOL_PLACE="Sheohar, Bihar"
VITE_SCHOOL_ADDRESS="Add the full school address here, Sheohar, Bihar"
VITE_ADMISSION_SESSION="2027-28"
VITE_OFFICE_HOURS="Mon - Sat, 8:00 AM - 3:00 PM"

# ---- Contact ----
VITE_PHONE="+91 00000 00000"
# WhatsApp number: country code + number, digits only (no + or spaces)
VITE_WHATSAPP_NUMBER="910000000000"
# Email shown on the website
VITE_EMAIL="info@tmhschool.com"

# ---- Where enquiry form + newsletter messages are delivered ----
VITE_QUERY_EMAIL="info@tmhschool.com"

# ---- Social media (leave empty to hide an icon) ----
VITE_INSTAGRAM_URL="https://www.instagram.com/your_school_page"
VITE_FACEBOOK_URL="https://www.facebook.com/your_school_page"
VITE_YOUTUBE_URL="https://www.youtube.com/@your_school_channel"

# ---- Optional: Google Maps embed link ----
# Google Maps > Share > Embed a map > copy only the link inside src="..."
VITE_MAP_EMBED_URL=""
