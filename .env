# ============================================================
#  T.M.H International School: site settings
#  Change a value here, then STOP and RESTART `npm run dev`.
#  (For a live site, run `npm run build` again.)
#  Never put passwords or secret keys in this file: everything
#  here becomes visible in the website code.
# ============================================================

# ---- School ----
VITE_SCHOOL_NAME="T.M.H International School"
VITE_SCHOOL_SHORT_NAME="T.M.H"
VITE_SCHOOL_PLACE="Sheohar, Bihar"
VITE_SCHOOL_ADDRESS="Add the full school address here, Sheohar, Bihar"
VITE_HOSTEL_ADDRESS="Add the full hostel address here, Sheohar, Bihar"
VITE_MOTTO="Learn Today, Lead Tomorrow"
VITE_OFFICE_HOURS="Mon - Sat, 8:00 AM - 3:00 PM"

# ---- Admission session ----
# Change this one value and the whole site updates: "Admissions are open for ...",
# news, event dates, age cut-off. Format: StartYear-EndYear (2 digits), e.g. 2028-29
VITE_ADMISSION_SESSION="2027-28"

# ---- People (shown on messages, management, hostel quote, faculty) ----
VITE_DIRECTOR_NAME="Director Name"
VITE_PRINCIPAL_NAME="Principal Name"
VITE_CHAIRMAN_NAME="Chairman Name"
VITE_MANAGER_NAME="Manager Name"

# ---- Contact ----
VITE_PHONE="+91 00000 00000"
# WhatsApp number: country code + number, digits only (no + or spaces)
VITE_WHATSAPP_NUMBER="910000000000"
# Email shown on the website
VITE_EMAIL="info@tmhschool.com"

# ---- Where enquiry / admission / hostel / newsletter messages are delivered ----
# Change this to any Gmail or other email. Messages go to this address.
# FIRST message after you change it: FormSubmit sends that inbox an
# activation email. Open it and click "Activate" once. After that all works.
VITE_QUERY_EMAIL="info@tmhschool.com"

# ---- Social media (leave empty to hide an icon) ----
VITE_INSTAGRAM_URL="https://www.instagram.com/your_school_page"
VITE_FACEBOOK_URL="https://www.facebook.com/your_school_page"
VITE_YOUTUBE_URL="https://www.youtube.com/@your_school_channel"

# ---- Google Maps ----
# "Open in Google Maps" links (Google Maps > Share > Copy link)
VITE_SCHOOL_MAP_LINK="https://maps.app.goo.gl/SJP2Yjc53SzCcdAKA"
VITE_HOSTEL_MAP_LINK="https://maps.app.goo.gl/SJP2Yjc53SzCcdAKA"
# Embedded map on the Contact page (Share > Embed a map > copy only the src="..." link)
VITE_MAP_EMBED_URL="https://maps.google.com/maps?q=26.516689679683076,85.30222469720431&z=17&output=embed"

# ---- School fees (SAMPLE amounts: replace with your real fees) ----
VITE_FEE_REGISTRATION="₹ 500"
VITE_FEE_ADMISSION="₹ 5,000"
VITE_FEE_ANNUAL="₹ 6,000 per year"
VITE_FEE_TUITION="₹ 1,200 per month"
VITE_FEE_TRANSPORT="₹ 800 onwards per month"

# ---- Hostel fees (SAMPLE amounts: replace with your real fees) ----
VITE_HOSTEL_FEE_ADMISSION="₹ 5,000"
VITE_HOSTEL_FEE_DEPOSIT="₹ 10,000 (refundable)"
VITE_HOSTEL_FEE_MONTHLY="₹ 3,000 per month"
VITE_HOSTEL_FEE_MESS="₹ 2,500 per month"
